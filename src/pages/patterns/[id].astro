---
import { getCollection, render } from 'astro:content';
import PatternIcon from '../../components/PatternIcon.astro';
import Base from '../../layouts/Base.astro';
import { categories, path } from '../../data/navigation';
export async function getStaticPaths() { return (await getCollection('patterns')).map(pattern => ({ params: { id: pattern.id }, props: { pattern } })); }
const { pattern } = Astro.props;
const all = (await getCollection('patterns')).sort((a,b)=>a.data.order-b.data.order);
const index = all.findIndex(p=>p.id===pattern.id);
const { Content, headings } = await render(pattern);
---
<Base title={pattern.data.title} description={pattern.data.intent}><div class="guide-shell"><aside class="sidebar"><a class="back-link" href={path('#catalog')}>← All patterns</a>{categories.map(category=><section><h2>{category}</h2>{all.filter(p=>p.data.category===category).map(p=><a class:list={{ active: p.id===pattern.id }} aria-current={p.id===pattern.id?'page':undefined} href={path(`patterns/${p.id}/`)}><PatternIcon slug={p.id}/><span>{p.data.title}</span>{p.data.status==='complete' && <span class="complete-dot" aria-label="Complete guide">●</span>}</a>)}</section>)}</aside><main id="main" class="guide-main" data-pagefind-body><header class="guide-heading"><p class="eyebrow" data-pagefind-filter={`category:${pattern.data.category}`}>{pattern.data.category} <span>/</span> Pattern {String(pattern.data.order).padStart(2,'0')}</p><div class="title-row"><h1 data-pagefind-meta="title"><PatternIcon slug={pattern.id}/>{pattern.data.title}</h1><span class="badge">{pattern.data.status==='complete'?'Complete guide':'Guide planned'}</span></div><p class="lead">{pattern.data.intent}</p><span class="search-metadata" data-pagefind-meta="keywords">{pattern.data.keywords.join(', ')}</span></header><article class="prose"><Content/></article><nav class="guide-pagination" aria-label="Adjacent patterns">{index>0?<a href={path(`patterns/${all[index-1].id}/`)}>← {all[index-1].data.title}</a>:<a href={path('#catalog')}>← Catalog</a>}{index<all.length-1&&<a href={path(`patterns/${all[index+1].id}/`)}>{all[index+1].data.title} →</a>}</nav></main><aside class="toc"><h2>On this page</h2><nav aria-label="On this page">{headings.filter(h=>h.depth===2).map(h=><a href={`#${h.slug}`}>{h.text}</a>)}</nav><button type="button" id="print-guide">Print / save PDF</button></aside></div></Base>
<script>document.getElementById('print-guide')?.addEventListener('click', () => window.print());</script>
