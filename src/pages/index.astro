---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { categories, descriptions, path } from '../data/navigation';
const patterns = (await getCollection('patterns')).sort((a,b) => a.data.order - b.data.order);
---
<Base title="Design patterns in practice"><main id="main" class="home"><section class="hero"><div><p class="eyebrow">A field guide for software engineers</p><h1>Good design starts<br/>with the <em>right question.</em></h1><p class="intro">Explore the 23 Gang of Four design patterns through plain-English explanations, diagrams, and working Java. Understand when a pattern earns its place.</p><div class="actions"><a class="primary-button" href={path('patterns/abstract-factory/')}>Start with Abstract Factory <span>→</span></a><a href="#catalog">Browse the catalog ↓</a></div><p class="edition">23 patterns <span>·</span> 3 categories <span>·</span> Java 21</p></div><div class="hero-illustration" aria-label="Abstract Factory creates matching heading and table products"><span class="eyebrow">One family. Matching parts.</span><div class="diagram-box">Report generator</div><div class="connector">↓ requests products</div><div class="diagram-box accent-box">Report component factory</div><div class="connector">↓ creates</div><div class="product-pair"><div class="diagram-box">Heading</div><div class="diagram-box">Table</div></div><a href={path('patterns/abstract-factory/')}>Explore Abstract Factory ↗</a></div></section><section class="featured"><div><p class="eyebrow">The first field guide</p><h2>Abstract Factory</h2><p>Choose a family once. Create its related objects through a common interface.</p></div><a href={path('patterns/abstract-factory/')}>Read the complete guide →</a></section><section id="catalog" class="catalog"><div class="section-heading"><div><p class="eyebrow">The complete catalog</p><h2>Three ways to think about design.</h2></div><a href={path('search/')}>Search all guides ↗</a></div><div class="category-grid">{categories.map((category, index) => <section class="category"><div class="category-heading"><span class="category-number">0{index+1}</span><span>{patterns.filter(p=>p.data.category===category).length} patterns</span></div><h3>{category}</h3><p class="muted">{descriptions[category]}</p><div class="pattern-links">{patterns.filter(p=>p.data.category===category).map(p=><a href={path(`patterns/${p.id}/`)}><span><strong>{p.data.title}</strong><small>{p.data.intent}</small></span><span class:list={['status',p.data.status]}>{p.data.status==='complete'?'Read guide ↗':'Outline ↗'}</span></a>)}</div></section>)}</div><p class="catalog-note">One complete guide to begin. The remaining 22 pages provide an intent and a consistent outline as the catalog grows.</p></section></main></Base>
