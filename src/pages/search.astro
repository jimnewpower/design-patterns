---
import Base from '../layouts/Base.astro';
import '@pagefind/default-ui/css/ui.css';
---
<Base title="Search the field guide"><main id="main" class="search-page"><p class="eyebrow">Find a pattern</p><h1>Search the guides</h1><p class="intro">Search by pattern name, problem, or Java type. For example: “undo”, “ReportFormatter”, or “shared state”.</p><div id="search"></div><p id="search-status" role="status"></p><p class="muted">Search covers all 23 guides, including their Java examples.</p></main></Base>
<script>
import { PagefindUI } from '@pagefind/default-ui';
new PagefindUI({ element: '#search', showSubResults: true, baseUrl: import.meta.env.BASE_URL, bundlePath: `${import.meta.env.BASE_URL.replace(/\/$/,'')}/pagefind/` });
</script>
