---
import '../styles/global.css';
import { path } from '../data/navigation';
interface Props { title: string; description?: string }
const { title, description = 'A practical field guide to the 23 Gang of Four design patterns, with Java examples.' } = Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={description}/><title>{title} · Pattern Atlas</title>
<script is:inline>try { document.documentElement.dataset.theme = localStorage.getItem('theme') || 'light'; } catch { document.documentElement.dataset.theme = 'light'; }</script>
</head><body><a class="skip" href="#main">Skip to content</a><header class="site-header"><a class="wordmark" href={path()} aria-label="Pattern Atlas home"><span class="mark" aria-hidden="true">P<span> / </span>A</span> Pattern Atlas</a><nav aria-label="Primary"><a href={path('#catalog')}>The patterns</a><a href={path('search/')}>Search</a><a class="repo-link" href="https://github.com/jimnewpower/design-patterns">GitHub ↗</a><button id="theme-toggle" type="button" aria-label="Switch to dark theme">Dark theme</button></nav></header><slot/><footer class="site-footer"><span>Pattern Atlas <span class="muted">/ Java edition</span></span><span>23 patterns · Java 21 examples</span><a href="https://github.com/jimnewpower/design-patterns">Source on GitHub ↗</a></footer>
<script>
const toggle = document.getElementById('theme-toggle')!;
function sync() { const dark = document.documentElement.dataset.theme === 'dark'; toggle.textContent = dark ? 'Light theme' : 'Dark theme'; toggle.setAttribute('aria-label', `Switch to ${dark ? 'light' : 'dark'} theme`); }
sync(); toggle.addEventListener('click', () => { const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'; document.documentElement.dataset.theme = theme; try { localStorage.setItem('theme', theme); } catch {} sync(); });
document.querySelectorAll('pre').forEach(pre => { const button = document.createElement('button'); button.className = 'copy'; button.textContent = 'Copy code'; button.type = 'button'; button.addEventListener('click', async () => { try { await navigator.clipboard.writeText(pre.querySelector('code')?.textContent || ''); button.textContent = 'Copied'; } catch { button.textContent = 'Select code to copy'; } setTimeout(() => button.textContent = 'Copy code', 2000); }); pre.append(button); });
</script></body></html>
